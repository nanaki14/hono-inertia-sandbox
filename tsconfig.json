{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["app/**/*", "vite.config.ts"]
}
