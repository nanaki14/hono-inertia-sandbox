{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "paths": {
      "@/*": ["./resources/js/*"]
    },
    "noEmit": true
  },
  "include": ["app/**/*", "resources/**/*", "vite.config.ts"]
}
